{
  "name": "my_quiz_bingo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/init-db.ts && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:init": "tsx scripts/init-db.ts",
